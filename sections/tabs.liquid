  }
  #ProductTabs-{{ section.id }} .product-tabs__panel.is-active {
    display: block;
  }
  #ProductTabs-{{ section.id }} .product-tabs__intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 28px;
  }
  #ProductTabs-{{ section.id }} .product-tabs__intro p {
    margin: 0;
    font-size: 16px;
    font-family: 'Space Grotesk', sans-serif;
    font-style: normal;
    font-weight: 400;
    line-height: 135%;
    color: #1b1b1b;
    max-width: 600px;
  }
  #ProductTabs-{{ section.id }} .product-tabs__arrows {
    display: flex;
    gap: 10px;
  }
  #ProductTabs-{{ section.id }} .product-tabs__arrow {
    width: 42px;
    height: 42px;
    border: 1px solid rgba(var(--color-foreground), .25);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #ProductTabs-{{ section.id }} .product-tabs__arrow.swiper-button-disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  #ProductTabs-{{ section.id }} .swiper {
    width: 100%;
    overflow: hidden;
  }
  #ProductTabs-{{ section.id }} .swiper-slide {
    height: auto;
  }
  #ProductTabs-{{ section.id }} .custom-card-product {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    height: 100%;
  }

  /* Media wrapper: holds both images + quick add overlay */
  #ProductTabs-{{ section.id }} .custom-card__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f5f5f5;
  }
  #ProductTabs-{{ section.id }} .custom-card__media-link {
    position: absolute;
    inset: 0;
    display: block;
  }
  #ProductTabs-{{ section.id }} .custom-card__img {
