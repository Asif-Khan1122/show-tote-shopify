{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

<section id="ProductTabs-{{ section.id }}" class="product-tabs">
  <div class="page-width">
    <h2 class="product-tabs__title">{{ section.settings.title }}</h2>

    <div class="product-tabs__header">
      <div class="product-tabs__buttons" role="tablist">
        {% for block in section.blocks %}
          <a
            class="product-tabs__tab{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {% endfor %}
      </div>
      {% if section.settings.shop_url != blank %}
        <a class="product-tabs__shop" href="{{ section.settings.shop_url }}">
          {{ section.settings.shop_text }}
        </a>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      <div
        class="product-tabs__panel{% if forloop.first %} is-active{% endif %}"
        data-panel="{{ block.id }}"
        role="tabpanel"
      >
        <div class="product-tabs__intro">
          <p>{{ block.settings.description }}</p>
          <div class="product-tabs__arrows">
            <button
              type="button"
              class="product-tabs__arrow product-tabs__arrow--prev-{{ block.id }}"
              aria-label="Previous products"
            >
              <img src="{{ 'left-arrow.svg' | asset_url }}" alt="" width="28" height="28">
            </button>
            <button
              type="button"
              class="product-tabs__arrow product-tabs__arrow--next-{{ block.id }}"
              aria-label="Next products"
            >
              <img src="{{ 'right-arrow.svg' | asset_url }}" alt="" width="28" height="28">
            </button>
          </div>
        </div>

        <div class="swiper swiper-{{ block.id }}">
          <div class="swiper-wrapper">
            {% if collection != blank and collection.products.size > 0 %}
              {% for product in collection.products limit: 8 %}
                {% assign current_variant = product.selected_or_first_available_variant %}
                <div class="swiper-slide product-tabs__product">
                  <div class="custom-card-product">
                    {%- comment -%} Product Image {%- endcomment -%}
                    <div class="custom-card__media">
                      <a href="{{ product.url }}" class="custom-card__media-link">
                        {% if product.featured_media %}
                          <img
                            src="{{ product.featured_media | image_url: width: 500 }}"
                            alt="{{ product.featured_media.alt | escape }}"
                            loading="lazy"
                            width="500"
                            height="500"
                            class="custom-card__img custom-card__img--primary"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'custom-card__img custom-card__img--primary' }}
                        {% endif %}

                        {% if product.media[1] %}
                          <img
                            src="{{ product.media[1] | image_url: width: 500 }}"
                            alt=""
                            loading="lazy"
                            width="500"
                            height="500"
                            class="custom-card__img custom-card__img--secondary"
                          >
                        {% endif %}
                      </a>

                      {%- comment -%} Add to cart on hover {%- endcomment -%}
                      <div class="custom-card__quick-add">
                        {% if product.has_only_default_variant %}
                          <button
                            type="button"
                            class="custom-card__atc-btn{% unless current_variant.available %} is-disabled{% endunless %}"
                            data-variant-id="{{ current_variant.id }}"
                            {% unless current_variant.available %}
                              disabled
                            {% endunless %}
                            aria-label="{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}"
                          >
                            <span class="custom-card__atc-icon">
                              <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M6 8h12l-1 12.5a1.5 1.5 0 0 1-1.5 1.5h-8a1.5 1.5 0 0 1-1.5-1.5L6 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                                <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="18.5" cy="17.5" r="4.5" fill="#000" stroke="#fff" stroke-width="1.2"/>
                                <path d="M18.5 15.5v4M16.5 17.5h4" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/>
                              </svg>
                            </span>
                            <span class="custom-card__atc-label">
                              {% if current_variant.available %}
                                Add
                              {% else %}
                                Sold out
                              {% endif %}
                            </span>
                          </button>
                        {% else %}
                          <a
                            href="{{ product.url }}"
                            class="custom-card__atc-btn custom-card__atc-btn--link"
                            aria-label="Select options"
                          >
                            <span class="custom-card__atc-icon">
                              <img
                                src="{{ 'add-to-cart.svg' | asset_url }}"
                                alt="Add to cart"
                                width="20"
                                height="20"
                              >
                            </span>
                            <span class="custom-card__atc-label">Add</span>
                          </a>
                        {% endif %}
                      </div>
                    </div>

                    <div class="custom-card__info">
                      <div class="card_title">
                        <h3 class="custom-card__title">
                          <a href="{{ product.url }}">{{ product.title }}</a>
                        </h3>

                        <div class="custom-card__price">
                          {% if product.compare_at_price > product.price %}
                            <span class="custom-card__price--sale">{{ product.price | money }}</span>
                            <s class="custom-card__price--compare">{{ product.compare_at_price | money }}</s>
                          {% else %}
                            <span>{{ product.price | money }}</span>
                          {% endif %}
                        </div>
                      </div>

                      <div class="meta__content">
                        {% if product.metafields.custom.colorway != blank %}
                          <div class="colorway_meta">{{ product.metafields.custom.colorway }}</div>
                        {% endif %}

                        {% if product.metafields.custom.dimensions_display != blank %}
                          <div
                            class="dimensions_meta"
                            data-type="{{ product.metafields.custom.dimensions_type }}"
                            data-height="{{ product.metafields.custom.dimensions_height }}"
                            data-width="{{ product.metafields.custom.dimensions_width }}"
                            data-depth="{{ product.metafields.custom.dimensions_depth }}"
                          >
                            {{ product.metafields.custom.dimensions_display }}
                          </div>
                        {% endif %}
                      </div>
                      {%- comment -%} Product Color Swatches {%- endcomment -%}
                      {% unless product.has_only_default_variant %}
                        <div class="custom-card__swatches">
                          {% for option in product.options_with_values %}
                            {% assign option_name_downcase = option.name | downcase %}
                            {% if option_name_downcase contains 'color'
                              or option_name_downcase contains 'colour'
                              or option_name_downcase contains 'rang'
                            %}
                              <div class="custom-card__swatch-list">
                                {% for value in option.values %}
                                  {% assign color_handle = value | handleize %}

                                  {%- comment -%} Variant Image Mapping {%- endcomment -%}
                                  {% assign variant_image = '' %}
                                  {% assign matched_variant_id = '' %}
                                  {% for variant in product.variants %}
                                    {% if variant.options contains value %}
                                      {% assign matched_variant_id = variant.id %}
                                      {% if variant.featured_media %}
                                        {% assign variant_image = variant.featured_media | image_url: width: 500 %}
                                      {% endif %}
                                      {% break %}
                                    {% endif %}
                                  {% endfor %}

                                  <button
                                    type="button"
                                    class="custom-card__swatch{% if option.selected_value == value %} is-active{% endif %}"
                                    style="background-color: {{ color_handle }};"
                                    title="{{ value }}"
                                    aria-label="{{ value }}"
                                    data-color-name="{{ value }}"
                                    data-variant-id="{{ matched_variant_id }}"
                                    data-product-url="{{ product.url }}"
                                    {% if variant_image != blank %}
                                      data-variant-image="{{ variant_image }}"
                                    {% endif %}
                                  ></button>
                                {% endfor %}
                              </div>
                            {% endif %}
                          {% endfor %}
                        </div>
                      {% endunless %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="swiper-slide">
                <p>Select a collection for this tab or add products to it.</p>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  #ProductTabs-{{ section.id }} {
    padding: 38px 0;
    color: #000;
  }
  #ProductTabs-{{ section.id }} .product-tabs__title {
    margin: 0 0 28px;
