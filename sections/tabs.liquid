    line-height: 1.1;
    text-transform: uppercase;
    color: #1b1b1b;
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: .5px;
    font-weight: 500;
  }
  #ProductTabs-{{ section.id }} .product-tabs__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 20px;
  }
  #ProductTabs-{{ section.id }} .product-tabs__buttons {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .card_title {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  #ProductTabs-{{ section.id }} .product-tabs__tab {
    padding: 14px 18px;
    background-color: {{ section.settings.tab_bg_color }};
    color: {{ section.settings.tab_text_color }};
    cursor: pointer;
    font: inherit;
    font-weight: 500;
    transition: all 0.25s ease-in-out;
    border: none;
    font-size: 14px;
    letter-spacing: .42px;
    line-height: normal;
    max-width: 150px;
    width: 100%;
    text-align: center;
    text-decoration: none;
  }
  #ProductTabs-{{ section.id }} .product-tabs__tab.is-active,
  #ProductTabs-{{ section.id }} .product-tabs__tab:hover {
    background-color: {{ section.settings.active_tab_bg }};
    color: {{ section.settings.active_tab_text }};
  }
  #ProductTabs-{{ section.id }} .product-tabs__shop {
    padding: 14px 18px;
    background: #000;
    color: #fff;
    width: 100%;
    max-width: 200px;
    align-items: center;
    border: 1px solid #000;
    text-decoration: none;
    white-space: nowrap;
    font-size: clamp(10px, 3vw, 14px);
    font-weight: 500;
    text-align: center;
    line-height: normal;
  }
  #ProductTabs-{{ section.id }} .product-tabs__shop:hover {
    background: #fff;
    color: #050505;
  }
  #ProductTabs-{{ section.id }} .product-tabs__panel {
