    opacity: 0;
    transform: translateY(8px) scale(.94);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  #ProductTabs-{{ section.id }} .custom-card__media:hover .custom-card__quick-add {
    opacity: 1;
    transform: translateY(0) scale(1);
