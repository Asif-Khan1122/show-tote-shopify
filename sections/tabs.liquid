  }
  #ProductTabs-{{ section.id }} .custom-card__atc-btn:hover .custom-card__atc-label,
  #ProductTabs-{{ section.id }} .custom-card__atc-btn:focus-visible .custom-card__atc-label {
    max-width: 90px;
    opacity: 1;
    padding-right: 18px;
  }
  #ProductTabs-{{ section.id }} .custom-card__atc-btn:hover {
    box-shadow: 0 6px 18px rgba(0, 0, 0, .24);
  }
  #ProductTabs-{{ section.id }} .custom-card__atc-btn.is-disabled,
  #ProductTabs-{{ section.id }} .custom-card__atc-btn[disabled] {
    color: #9c9c9c;
    cursor: not-allowed;
    pointer-events: none;
  }
  #ProductTabs-{{ section.id }} .custom-card__atc-btn.is-added .custom-card__atc-icon {
    color: #2f7d3c;
  }
  #ProductTabs-{{ section.id }} .custom-card__atc-btn.is-added .custom-card__atc-label {
    color: #2f7d3c;
  }
  #ProductTabs-{{ section.id }} .custom-card__atc-btn.is-error .custom-card__atc-icon,
  #ProductTabs-{{ section.id }} .custom-card__atc-btn.is-error .custom-card__atc-label {
    color: #b3261e;
  }

  #ProductTabs-{{ section.id }} .custom-card__info {
    display: flex;
    flex-direction: column;
    padding: 10px 10px 3px;
  }
  #ProductTabs-{{ section.id }} .custom-card__title {
    font-size: clamp(14px, 3vw, 15px);
    font-weight: 500;
    margin: 0;
    line-height: normal;
    font-family: 'Space Grotesk', sans-serif;
    color: #1b1b1b;
    display: flex;
    align-items: center;
    letter-spacing: 0;
  }
  #ProductTabs-{{ section.id }} .custom-card__title a {
    text-decoration: none;
    color: #1b1b1b;
  }
  #ProductTabs-{{ section.id }} .custom-card__price {
    font-size: clamp(11px, 3vw, 14px);
    font-weight: 500;
  }
  #ProductTabs-{{ section.id }} .custom-card__price--sale {
    color: #d90429;
    font-weight: 600;
  }
  #ProductTabs-{{ section.id }} .custom-card__price--compare {
    color: #888888;
    margin-left: 6px;
    font-size: 12px;
  }
  #ProductTabs-{{ section.id }} .custom-card__description {
    font-size: 12px;
    color: #666666;
    line-height: 1.4;
  }
  #ProductTabs-{{ section.id }} .custom-card__swatches {
    margin-top: 6px;
  }
  #ProductTabs-{{ section.id }} .custom-card__swatch-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  #ProductTabs-{{ section.id }} .custom-card__swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: none;
    outline: none;
    cursor: pointer;
    padding: 0;
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 3.5px #e5e5e5;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    background-size: cover;
    background-position: center;
  }

  #ProductTabs-{{ section.id }} .custom-card__swatch.is-active {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 3.5px #000000;
  }

  #ProductTabs-{{ section.id }} .custom-card__swatch:hover:not(.is-active) {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 3.5px #111111;
  }
       @media screen and (max-width: 749px) {
        #ProductTabs-{{ section.id }} .product-tabs__title {
          font-size: 26px;
        }
        #ProductTabs-{{ section.id }} .product-tabs__header {
          display: block;
        }
        #ProductTabs-{{ section.id }} .product-tabs__shop {
          display: inline-block;
          margin-top: 20px;
        }
        /* On touch devices there's no hover, so keep the icon pinned in the
           corner, always visible, and already expanded to show the label */
        #ProductTabs-{{ section.id }} .custom-card__quick-add {
          opacity: 1;
          transform: translateY(0) scale(1);
          pointer-events: auto;
        }
        #ProductTabs-{{ section.id }} .custom-card__atc-label {
          max-width: 90px;
          opacity: 1;
          padding-right: 16px;
        }
        #ProductTabs-{{ section.id }} .custom-card__img--secondary {
          display: none;
        }
      }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('#ProductTabs-{{ section.id }}');
    if (!root) return;

    const tabs = root.querySelectorAll('[data-tab]');
    const panels = root.querySelectorAll('[data-panel]');
    const swiperInstances = {};

    // Initialize Swiper for each panel
    panels.forEach((panel) => {
      const blockId = panel.dataset.panel;
      const swiperContainer = panel.querySelector(`.swiper-${blockId}`);

      if (swiperContainer) {
        swiperInstances[blockId] = new Swiper(swiperContainer, {
          slidesPerView: 1.2,
          spaceBetween: 16,
          observer: true,
          observeParents: true,
          simulateTouch: true,
          grabCursor: true,
          freeMode: {
            enabled: true,
            sticky: false,
            momentum: true,
            momentumRatio: 1,
          },
          mousewheel: {
            forceToAxis: true,
            sensitivity: 1,
            releaseOnEdges: true,
          },
          navigation: {
            nextEl: `.product-tabs__arrow--next-${blockId}`,
            prevEl: `.product-tabs__arrow--prev-${blockId}`,
          },
          breakpoints: {
            550: { slidesPerView: 2.2, spaceBetween: 8 },
            750: { slidesPerView: 3.2, spaceBetween: 10 },
            990: { slidesPerView: 4, spaceBetween: 10 },
          },
        });
      }
    });

    // Tab Switching Logic
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const tabId = tab.dataset.tab;

        tabs.forEach((item) => {
          item.classList.remove('is-active');
          item.setAttribute('aria-selected', 'false');
        });

        panels.forEach((panel) => {
          panel.classList.remove('is-active');
        });

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const activePanel = root.querySelector(`[data-panel="${tabId}"]`);
        if (activePanel) {
          activePanel.classList.add('is-active');
          if (swiperInstances[tabId]) {
            swiperInstances[tabId].update();
          }
        }
      });
    });

    // Swatch Click Listener — navigates to that color's product page (variant),
    // using the product's own URL + the matched variant id. No hardcoded URLs,
    // no new data structure — this uses the same product.url / variant mapping
    // that already exists in the Liquid above.
    root.querySelectorAll('.custom-card__swatch').forEach((swatch) => {
      swatch.addEventListener('click', (e) => {
        e.preventDefault();

        const productUrl = swatch.dataset.productUrl;
        const variantId = swatch.dataset.variantId;

        if (!productUrl) return;

        if (variantId) {
          window.location.href = `${productUrl}?variant=${variantId}`;
        } else {
          // Fallback: no matching variant found, just go to the product page
          window.location.href = productUrl;
        }
      });
    });

    // Quick "Add to cart" on hover
    root.querySelectorAll('.custom-card__atc-btn[data-variant-id]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        if (btn.disabled || btn.classList.contains('is-disabled')) return;

        const variantId = btn.dataset.variantId;
        const label = btn.querySelector('.custom-card__atc-label');
        const originalText = label.textContent;

        btn.disabled = true;
        label.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] }),
          });

          if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            throw new Error(err.description || 'Could not add item to cart');
          }

          label.textContent = 'Added ✓';
          btn.classList.add('is-added');

          // Notify the theme's cart drawer / cart icon bubble to refresh, if present
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          const cartDrawer = document.querySelector('cart-drawer, cart-notification');
          if (cartDrawer) {
            fetch('/cart.js')
              .then((r) => r.json())
              .then((cart) => {
                document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
                if (typeof cartDrawer.renderContents === 'function') {
                  fetch(window.location.pathname + '?section_id=cart-drawer')
                    .then((r) => r.text())
                    .then((html) => {
                      const parser = new DOMParser();
                      const doc = parser.parseFromString(html, 'text/html');
                      const newDrawer = doc.querySelector('cart-drawer');
                      if (newDrawer) cartDrawer.innerHTML = newDrawer.innerHTML;
                      if (typeof cartDrawer.open === 'function') cartDrawer.open();
                    })
                    .catch(() => {});
                }
              })
              .catch(() => {});
          }

          setTimeout(() => {
            btn.classList.remove('is-added');
            label.textContent = originalText;
            btn.disabled = false;
          }, 1800);
        } catch (err) {
          label.textContent = 'Error';
          btn.classList.add('is-error');
          setTimeout(() => {
            btn.classList.remove('is-error');
            label.textContent = originalText;
            btn.disabled = false;
          }, 1800);
        }
      });
    });
  });
</script>

